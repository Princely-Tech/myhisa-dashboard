# SANDBOX: environment for the separately built/deployed SANDBOX dashboard.
# Copy to .env.production.local in the sandbox checkout (gitignored) before
# `npm run build`. NEXT_PUBLIC_* values are baked in at build time - changing
# them needs a rebuild. See docs/SANDBOX_DASHBOARD.md.

# Sandbox Go API base. Same shape as live: must include /api/ and END WITH A
# SLASH (endpoints are appended directly, e.g. "<base>auth/login").
NEXT_PUBLIC_API_URL=https://sandbox-api.example.com/api/

# Turns on sandbox mode (banner, sandbox tools, optional KYC uploads, ...).
# Anything else / unset = live.
NEXT_PUBLIC_ENVIRONMENT=sandbox

# Optional: live dashboard URL for the banner's "Go to live dashboard" link.
# Leave empty to hide the link.
NEXT_PUBLIC_LIVE_DASHBOARD_URL=https://dashboard.example.com
