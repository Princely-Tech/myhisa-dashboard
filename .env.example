# Environment for the LIVE dashboard build. Copy to .env.local (dev) or
# .env.production.local (build); both are gitignored. NEXT_PUBLIC_* values are
# baked in at build time - changing them needs a rebuild. The sandbox build
# uses .env.sandbox.example instead.

# Go API base: must include /api/ and END WITH A SLASH.
NEXT_PUBLIC_API_URL=https://api.example.com/api/

# Optional: sandbox dashboard URL, linked from the "While you wait" card on
# the onboarding status page. Leave empty to hide the card.
NEXT_PUBLIC_SANDBOX_DASHBOARD_URL=https://sandbox-dashboard.example.com

# Optional: terms, privacy and pricing pages linked from sign-up and the
# onboarding status page. Unset = the in-app /documentation page.
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_PRICING_URL=
